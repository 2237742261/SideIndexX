<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 配置通道写入系统设置库；可用 pm grant / root 授予，未授予时退化成 su 命令 -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- 读取前台应用（只有 SystemUI 侧反射 ActivityTaskManager 失败时才用，需要 appops 授权） -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <application
        android:allowBackup="false"
        android:description="@string/xposed_description"
        android:icon="@drawable/ic_side_index_flyme"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.AppPickerActivity"
            android:exported="false"
            android:label="@string/pick_app" />

        <!-- 配置读取通道（跨应用免权限调用；SystemUI 承载模式下优先走 Settings.Secure） -->
        <provider
            android:name=".settings.ConfigProvider"
            android:authorities="com.eta.sideindexx.config"
            android:enabled="true"
            android:exported="true" />

        <!-- ============ LSPosed 模块声明（libxposed 新版 API，1.32.0 起）============
             模块元信息不再走 meta-data，而是 APK 根下的三个文件：
               META-INF/xposed/module.prop      minApiVersion / targetApiVersion = 102 …
               META-INF/xposed/java_init.list   入口类 com.eta.sideindexx.EtaModule
               META-INF/xposed/scope.list       作用域 com.android.systemui
             模块名取 android:label，描述取 android:description（都在 <application> 上）。
             旧的 xposedmodule / xposedminversion / xposedscope / xposedsharedprefs 已全部去掉。 -->

    </application>
</manifest>
